{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source={PrivateFolder}/miniledger.db"
  },
  "Jwt": {
    "Key": "REPLACE_VIA_ENV_Jwt__Key",
    "Issuer": "MiniLedger.Api",
    "Audience": "MiniLedger.Client",
    "ExpireMinutes": 60
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/accounts/access",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/accounts/access",
        "Period": "1h",
        "Limit": 20
      }
    ]
  }
}
